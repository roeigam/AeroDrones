---
/**
 * Viewfinder-style frame: four accent corner brackets, edge ticks, scan tint,
 * and small decorative mono labels in the corners (aria-hidden).
 * The framed content (a photo) is passed in the default slot and never mirrors.
 * lock = when the frame scrolls into view (reveal adds .is-visible), the brackets "lock on"
 * like a camera acquiring focus and a scan line sweeps once.
 */
interface Props {
  labels?: { start?: string; end?: string; bottomStart?: string; bottomEnd?: string };
  rec?: boolean;
  recLabel?: string;
  class?: string;
  ratio?: string;
  lock?: boolean;
  [key: string]: unknown;
}
const { labels = {}, rec = false, recLabel = 'REC', class: className, ratio, lock = false, ...rest } = Astro.props;
---
<figure
  class:list={['hud', lock && 'hud--lock', className]}
  style={ratio ? `--hud-ratio: ${ratio}` : undefined}
  data-reveal={lock ? '' : undefined}
  {...rest}
>
  <div class="hud__media">
    <slot />
    <span class="hud__scan" aria-hidden="true"></span>
    {lock && <span class="hud__sweep" aria-hidden="true"></span>}
  </div>

  <span class="hud__corner hud__corner--ss" aria-hidden="true"></span>
  <span class="hud__corner hud__corner--se" aria-hidden="true"></span>
  <span class="hud__corner hud__corner--es" aria-hidden="true"></span>
  <span class="hud__corner hud__corner--ee" aria-hidden="true"></span>

  <span class="hud__tick hud__tick--top" aria-hidden="true"></span>
  <span class="hud__tick hud__tick--bottom" aria-hidden="true"></span>
  <span class="hud__tick hud__tick--start" aria-hidden="true"></span>
  <span class="hud__tick hud__tick--end" aria-hidden="true"></span>
  <span class="hud__cross" aria-hidden="true"></span>

  <span class="hud__label hud__label--ss t-mono" aria-hidden="true" dir="ltr">
    {rec && <span class="hud__rec"><span class="hud__rec-dot"></span>{recLabel}</span>}
    {labels.start}
  </span>
  {labels.end && <span class="hud__label hud__label--se t-mono" aria-hidden="true" dir="ltr">{labels.end}</span>}
  {labels.bottomStart && <span class="hud__label hud__label--es t-mono" aria-hidden="true" dir="ltr">{labels.bottomStart}</span>}
  {labels.bottomEnd && <span class="hud__label hud__label--ee t-mono" aria-hidden="true" dir="ltr">{labels.bottomEnd}</span>}
  <slot name="caption" />
</figure>

<style>
  .hud {
    --c: 22px;           /* corner bracket length */
    --o: -10px;          /* bracket offset outside the media */
    --t: 1.5px;          /* bracket thickness */
    position: relative;
    margin: 0;
    padding: 0;
  }
  .hud__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: var(--hud-ratio, auto);
    background: var(--surface-1);
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--line);
  }
  .hud__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  /* soft vignette + faint scanlines */
  .hud__scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 90% at 50% 50%, transparent 55%, rgb(2 6 14 / 0.55) 100%),
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, var(--accent-5), transparent 40%);
  }

  .hud__corner {
    position: absolute;
    inline-size: var(--c);
    block-size: var(--c);
    border: 0 solid var(--accent);
    filter: drop-shadow(0 0 4px var(--accent-60));
    pointer-events: none;
  }
  .hud__corner--ss { inset-block-start: var(--o); inset-inline-start: var(--o); border-block-start-width: var(--t); border-inline-start-width: var(--t); border-start-start-radius: 6px; }
  .hud__corner--se { inset-block-start: var(--o); inset-inline-end: var(--o); border-block-start-width: var(--t); border-inline-end-width: var(--t); border-start-end-radius: 6px; }
  .hud__corner--es { inset-block-end: var(--o); inset-inline-start: var(--o); border-block-end-width: var(--t); border-inline-start-width: var(--t); border-end-start-radius: 6px; }
  .hud__corner--ee { inset-block-end: var(--o); inset-inline-end: var(--o); border-block-end-width: var(--t); border-inline-end-width: var(--t); border-end-end-radius: 6px; }

  .hud__tick {
    position: absolute;
    background: var(--accent-60);
    pointer-events: none;
  }
  .hud__tick--top, .hud__tick--bottom { inline-size: 1px; block-size: 10px; inset-inline-start: 50%; }
  .hud__tick--top { inset-block-start: calc(var(--o) - 2px); }
  .hud__tick--bottom { inset-block-end: calc(var(--o) - 2px); }
  .hud__tick--start, .hud__tick--end { block-size: 1px; inline-size: 10px; inset-block-start: 50%; }
  .hud__tick--start { inset-inline-start: calc(var(--o) - 2px); }
  .hud__tick--end { inset-inline-end: calc(var(--o) - 2px); }

  .hud__cross {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 28px;
    block-size: 28px;
    margin-block-start: -14px;
    margin-inline-start: -14px;
    pointer-events: none;
    opacity: 0.5;
    background:
      linear-gradient(var(--accent-60), var(--accent-60)) center / 1px 100% no-repeat,
      linear-gradient(var(--accent-60), var(--accent-60)) center / 100% 1px no-repeat;
    -webkit-mask: radial-gradient(circle, transparent 4px, #000 4.5px);
    mask: radial-gradient(circle, transparent 4px, #000 4.5px);
  }

  .hud__label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    font-size: 0.625rem;
    color: var(--accent-soft);
    opacity: 0.85;
    pointer-events: none;
    text-shadow: 0 0 8px rgb(0 0 0 / 0.8);
  }
  .hud__label--ss { inset-block-start: 12px; inset-inline-start: 14px; }
  .hud__label--se { inset-block-start: 12px; inset-inline-end: 14px; }
  .hud__label--es { inset-block-end: 12px; inset-inline-start: 14px; }
  .hud__label--ee { inset-block-end: 12px; inset-inline-end: 14px; }

  .hud__rec { display: inline-flex; align-items: center; gap: 0.45em; color: var(--text); }
  .hud__rec-dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--danger);
    box-shadow: 0 0 8px var(--danger);
    animation: rec-blink 1.6s steps(1, end) infinite;
  }
  @keyframes rec-blink { 50% { opacity: 0.15; } }

  /* ---- Lock-on (scroll reveal) ---- */
  .hud__sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent calc(100% - 2px), var(--accent) calc(100% - 1px), transparent),
      linear-gradient(180deg, transparent 70%, var(--accent-10));
    transform: translate3d(0, -100%, 0);
    opacity: 0;
  }
  :global(.js) .hud--lock .hud__corner,
  :global(.js) .hud--lock .hud__label,
  :global(.js) .hud--lock .hud__cross {
    opacity: 0;
    transform: scale(1.6);
    transition: opacity 500ms var(--ease-out), transform 700ms var(--ease-spring);
  }
  :global(.js) .hud--lock .hud__label { transform: none; }
  :global(.js) .hud--lock.is-visible .hud__corner { opacity: 1; transform: none; transition-delay: 250ms; }
  :global(.js) .hud--lock.is-visible .hud__cross { opacity: 0.5; transform: none; transition-delay: 450ms; }
  :global(.js) .hud--lock.is-visible .hud__label { opacity: 0.85; transition-delay: 800ms; }
  .hud--lock.is-visible .hud__sweep { animation: hud-sweep 1400ms var(--ease-in-out) 350ms both; }
  @keyframes hud-sweep {
    0% { transform: translate3d(0, -100%, 0); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translate3d(0, 100%, 0); opacity: 0; }
  }

  @media (max-width: 640px) {
    .hud { --c: 16px; --o: -7px; }
    .hud__label { font-size: 0.5625rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hud__sweep { display: none; }
    .hud__rec-dot { animation: none; }
  }
</style>
