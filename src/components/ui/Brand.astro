---
/**
 * Brand mark + "AeroDrones" wordmark. The brand is never translated.
 * On Hebrew pages it is wrapped in <bdi> so it renders correctly inside RTL text.
 * The mark is a logo: it never mirrors.
 */
import { shared } from '../../content/site';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  size?: 'sm' | 'md' | 'lg';
  showMark?: boolean;
}
const { lang, size = 'md', showMark = true } = Astro.props;
const brand = shared.brand;
const gid = `bm-${Math.random().toString(36).slice(2, 8)}`;
// Split "AeroDrones" → "Aero" + "Drones" for the two-tone wordmark (falls back to one tone).
const m = brand.match(/^([A-Z][a-z]+)(.+)$/);
const [first, second] = m ? [m[1], m[2]] : [brand, ''];
---
<span class:list={['brand', `brand--${size}`]}>
  {showMark && (
    <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" style="stop-color: var(--accent)" />
          <stop offset="1" style="stop-color: var(--secondary)" />
        </linearGradient>
      </defs>
      <g fill="none" stroke={`url(#${gid})`} stroke-width="1.6" stroke-linecap="round">
        <circle cx="7" cy="7" r="4.2" /><circle cx="25" cy="7" r="4.2" />
        <circle cx="7" cy="25" r="4.2" /><circle cx="25" cy="25" r="4.2" />
        <path d="m10 10 3.2 3.2M22 10l-3.2 3.2M10 22l3.2-3.2M22 22l-3.2-3.2" />
        <path d="M16 11.5 20.5 16 16 20.5 11.5 16Z" />
      </g>
      <circle cx="16" cy="16" r="1.6" style="fill: var(--accent)" />
    </svg>
  )}
  {lang === 'he'
    ? <bdi class="brand__word" dir="ltr"><span>{first}</span><span class="brand__accent">{second}</span></bdi>
    : <span class="brand__word"><span>{first}</span><span class="brand__accent">{second}</span></span>}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }
  .brand--sm { font-size: 1.05rem; }
  .brand--md { font-size: 1.25rem; }
  .brand--lg { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); }
  .brand__mark {
    inline-size: 1.55em;
    block-size: 1.55em;
    filter: drop-shadow(0 0 6px var(--accent-35));
  }
  .brand__accent { color: var(--accent); }
</style>
