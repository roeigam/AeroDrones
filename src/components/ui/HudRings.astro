---
/**
 * Decorative concentric HUD rings with degree ticks, rotating slowly in opposite
 * directions (transform only). Purely decorative, aria-hidden.
 */
// 72 degree ticks drawn as 3 paths (major / mid / minor) instead of 72 <line> elements (smaller DOM).
const tickPath = (filter: (deg: number) => boolean, len: number) =>
  Array.from({ length: 72 }, (_, i) => i * 5)
    .filter(filter)
    .map((deg) => {
      const a = (deg * Math.PI) / 180;
      const p = (r: number) => `${(200 + r * Math.sin(a)).toFixed(2)} ${(200 - r * Math.cos(a)).toFixed(2)}`;
      return `M${p(196)}L${p(196 - len)}`;
    })
    .join('');
const major = tickPath((d) => d % 45 === 0, 14);
const mid = tickPath((d) => d % 45 !== 0 && d % 15 === 0, 8);
const minor = tickPath((d) => d % 15 !== 0, 4);
---
<div class="rings" aria-hidden="true">
  <svg class="rings__outer" viewBox="0 0 400 400" fill="none">
    <circle cx="200" cy="200" r="196" style="stroke: var(--accent-20)" stroke-width="1" />
    <path d={major} style="stroke: var(--accent-60)" stroke-width="1" />
    <path d={mid} style="stroke: var(--accent-20)" stroke-width="1" />
    <path d={minor} style="stroke: var(--accent-20)" stroke-width="1" />
    <path d="M200 4 A196 196 0 0 1 338.6 61.4" style="stroke: var(--accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />
  </svg>
  <svg class="rings__inner" viewBox="0 0 400 400" fill="none">
    <circle cx="200" cy="200" r="150" style="stroke: var(--secondary-35)" stroke-width="1" stroke-dasharray="2 6" />
    <path d="M50 200 A150 150 0 0 1 120 73" style="stroke: var(--accent-60)" stroke-width="1.25" stroke-linecap="round" />
    <path d="M350 200 A150 150 0 0 1 280 327" style="stroke: var(--secondary)" stroke-width="1.25" stroke-linecap="round" opacity="0.7" />
    <circle cx="200" cy="200" r="104" style="stroke: var(--accent-10)" stroke-width="1" />
  </svg>
</div>

<style>
  .rings {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .rings svg { grid-area: 1 / 1; inline-size: 100%; block-size: 100%; }
  .rings__outer { animation: ring-spin var(--dur-ring) linear infinite; }
  .rings__inner { animation: ring-spin calc(var(--dur-ring) * 0.75) linear infinite reverse; }
  @keyframes ring-spin { to { transform: rotate(360deg); } }
</style>
