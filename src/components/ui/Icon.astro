---
/**
 * One consistent line-icon set: 24px grid, 1.5 stroke, round caps/joins, currentColor.
 * Directional icons (arrow, chevron) get .icon--dir and mirror in RTL automatically.
 * Icon-only buttons must provide their own aria-label; icons are aria-hidden.
 */
export type IconName =
  | 'arrow' | 'chevron' | 'arrow-down' | 'close' | 'menu' | 'check' | 'alert' | 'send'
  | 'build' | 'repair' | 'tune'
  | 'whatsapp' | 'instagram' | 'youtube' | 'tiktok' | 'facebook' | 'mail' | 'phone' | 'expand';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', strokeWidth = 1.5 } = Astro.props;
const directional = new Set<IconName>(['arrow', 'chevron', 'send']);
const filled = new Set<IconName>(['whatsapp']);
const cls = ['icon', directional.has(name) ? 'icon--dir' : '', className].filter(Boolean).join(' ');
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled.has(name) ? 'currentColor' : 'none'}
  stroke={filled.has(name) ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && (<><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></>)}
  {name === 'chevron' && <path d="m9 5 7 7-7 7" />}
  {name === 'arrow-down' && (<><path d="M12 4v15" /><path d="m6 13 6 6 6-6" /></>)}
  {name === 'close' && (<><path d="M6 6l12 12" /><path d="M18 6 6 18" /></>)}
  {name === 'menu' && (<><path d="M4 7h16" /><path d="M4 12h10" /><path d="M4 17h16" /></>)}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'alert' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5" /><path d="M12 16.5h.01" /></>)}
  {name === 'send' && (<><path d="M4 12 20 4l-5 16-3.5-6.5L4 12Z" /><path d="m11.5 13.5 4-4" /></>)}
  {name === 'expand' && (<><path d="M4 9V4h5" /><path d="M20 9V4h-5" /><path d="M4 15v5h5" /><path d="M20 15v5h-5" /></>)}

  {name === 'build' && (
    <>
      {/* quad frame, top view */}
      <circle cx="5.5" cy="5.5" r="3" /><circle cx="18.5" cy="5.5" r="3" />
      <circle cx="5.5" cy="18.5" r="3" /><circle cx="18.5" cy="18.5" r="3" />
      <path d="m7.6 7.6 2.2 2.2M16.4 7.6l-2.2 2.2M7.6 16.4l2.2-2.2M16.4 16.4l-2.2-2.2" />
      <rect x="9.5" y="9.5" width="5" height="5" rx="1.2" />
      <path d="M12 11.3v1.4" />
    </>
  )}
  {name === 'repair' && (
    <>
      {/* wrench + spark */}
      <path d="M14.7 6.3a4 4 0 0 0-5.2 5.2l-5.3 5.3a1.6 1.6 0 0 0 2.3 2.3l5.3-5.3a4 4 0 0 0 5.2-5.2l-2.4 2.4-2.3-.6-.6-2.3 3-1.8Z" />
      <path d="M19 15.5v3M17.5 17h3" />
    </>
  )}
  {name === 'tune' && (
    <>
      {/* gauge with needle + upgrade tick */}
      <path d="M4.2 16.5a8.5 8.5 0 1 1 15.6 0" />
      <path d="m12 13.5 4-4.5" />
      <circle cx="12" cy="14" r="1.4" />
      <path d="M6.5 12.5h1M16.5 12.5h1M12 7V8" />
      <path d="M8.5 20h7" />
    </>
  )}

  {name === 'mail' && (<><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="m4 7 8 6 8-6" /></>)}
  {name === 'phone' && <path d="M6.6 3.5h2.6l1.3 4-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2 4 1.3v2.6a2 2 0 0 1-2.2 2A16 16 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17 7h.01" /></>)}
  {name === 'youtube' && (<><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="m10.5 9.5 4 2.5-4 2.5v-5Z" /></>)}
  {name === 'tiktok' && <path d="M14 3.5v11a3.5 3.5 0 1 1-3.5-3.5M14 3.5c.4 2.6 2.2 4.4 4.8 4.6" />}
  {name === 'facebook' && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.6 1.6-1.6H17.6V4.3c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.2H8.5v3h2.7V21" />}
  {name === 'whatsapp' && (
    <path d="M12 2.5a9.4 9.4 0 0 0-8.1 14.2L2.6 21.4l4.8-1.3A9.4 9.4 0 1 0 12 2.5Zm0 17.2c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A7.8 7.8 0 1 1 12 19.7Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2Z" />
  )}
</svg>

<style>
  .icon { flex-shrink: 0; transition: transform var(--dur-base) var(--ease-out); }
</style>
