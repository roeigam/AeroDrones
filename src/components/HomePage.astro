---
/**
 * The one-page site, rendered for a given language. Both /index.astro (he) and /en/index.astro (en)
 * render this, so there is no duplicated markup.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Services from './sections/Services.astro';
import Builds from './sections/Builds.astro';
import Contact from './sections/Contact.astro';
import WhatsAppFab from './WhatsAppFab.astro';
import { content, whatsappHref } from '../content/site';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} localized skipLabel={t.a11y.skipToContent}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    <About lang={lang} />
    <Services lang={lang} />
    <Builds lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <WhatsAppFab href={whatsappHref(lang)} label={t.contact.whatsapp.fabLabel} />
</BaseLayout>

<script>
  import '../scripts/reveal';
</script>

<style>
  main:focus { outline: none; }
</style>
