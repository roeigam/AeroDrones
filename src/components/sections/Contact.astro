---
/**
 * Contact: info column (WhatsApp card + quick facts) beside a glass form panel.
 * The form works without JS (plain POST to Web3Forms). With JS (src/scripts/contact.ts) it validates
 * in the current language and submits via fetch with loading / success / error states.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import GlassCard from '../ui/GlassCard.astro';
import Field from '../ui/Field.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { content, shared, whatsappHref } from '../../content/site';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const c = t.contact;
const f = c.form;
const h = t.sections.contact;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const wa = whatsappHref(lang);
---
<section class="section section--band contact" id="contact" data-section aria-labelledby="contact-title">
  <div class="contact__glow glow-pool" aria-hidden="true"></div>
  <div class="contact__glow contact__glow--2 glow-pool glow-pool--secondary" aria-hidden="true"></div>

  <div class="container contact__grid">
    <div class="contact__info">
      <SectionHeading num={h.num} label={h.label} title={h.title} lede={c.lede} id="contact-title" />

      <GlassCard class="wa-card" data-reveal style="--i: 3">
        <span class="wa-card__icon" aria-hidden="true"><Icon name="whatsapp" size={30} /></span>
        <div class="wa-card__body">
          <h3 class="t-h3 wa-card__title">{c.whatsapp.title}</h3>
          <p class="wa-card__text">{c.whatsapp.text}</p>
          <Button href={wa} variant="whatsapp" icon="arrow" target="_blank" rel="noopener noreferrer">
            {c.whatsapp.cta}
          </Button>
        </div>
      </GlassCard>

      {c.facts.length > 0 && (
        <dl class="facts" data-reveal style="--i: 4">
          {c.facts.map((fact) => (
            <div class="fact">
              <dt class="fact__label t-mono">{fact.label}</dt>
              <dd class="fact__value">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <div class="contact__form-wrap" data-reveal style="--i: 2">
      <GlassCard class="cf-panel" interactive={false}>
        <div class="cf-panel__head">
          <h3 class="t-h3">{f.title}</h3>
          <p class="cf-panel__req"><span aria-hidden="true">*</span> {f.requiredNote}</p>
        </div>

        <form
          class="cf"
          action="https://api.web3forms.com/submit"
          method="POST"
          data-contact-form
          data-errors={JSON.stringify(f.errors)}
          data-sending={f.sending}
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value={f.subject} />
          <input type="hidden" name="from_name" value={shared.formFromName} />
          <input type="hidden" name="language" value={f.language} />
          {/* Web3Forms honeypot: bots tick it, humans never see it */}
          <input type="checkbox" name="botcheck" class="cf__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="cf__row">
            <Field label={f.name} name="name" autocomplete="name" required placeholder={f.namePlaceholder} maxlength={80} />
            <Field label={f.phone} name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder={f.phonePlaceholder} maxlength={24} />
          </div>
          <Field label={f.email} name="email" type="email" inputmode="email" autocomplete="email" note={f.emailOptional} placeholder={f.emailPlaceholder} maxlength={120} />
          <Field label={f.message} name="message" type="textarea" required placeholder={f.messagePlaceholder} minlength={10} maxlength={3000} rows={5} />

          <div class="cf__alert" role="alert" data-cf-error hidden>
            <span class="cf__alert-icon" aria-hidden="true"><Icon name="alert" size={18} strokeWidth={2} /></span>
            <p><strong>{f.error.title}</strong> {f.error.text}</p>
            <a class="cf__alert-link" href={wa} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={16} /> {shared.whatsappName}
            </a>
          </div>

          <div class="cf__foot">
            <Button type="submit" variant="primary" size="lg" icon="send" data-cf-submit>{f.submit}</Button>
            <p class="cf__privacy">{f.privacy}</p>
          </div>
          <p class="visually-hidden" aria-live="polite" data-cf-live></p>
        </form>

        <div class="cf-success" data-cf-success hidden tabindex="-1">
          <span class="cf-success__icon" aria-hidden="true"><Icon name="check" size={34} strokeWidth={2} /></span>
          <h3 class="t-h3">{f.success.title}</h3>
          <p class="t-muted">{f.success.text}</p>
          <Button variant="ghost" data-cf-again>{f.success.again}</Button>
        </div>
      </GlassCard>
    </div>
  </div>
</section>

<script>
  import '../../scripts/contact';
</script>

<style>
  .contact__glow { inline-size: min(52rem, 110vw); inset-block-start: 15%; inset-inline-end: -15%; opacity: 0.8; z-index: -1; }
  .contact__glow--2 { inline-size: min(40rem, 90vw); inset-block-start: 55%; inset-inline-end: 20%; opacity: 0.6; }

  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  @media (min-width: 1024px) {
    .contact__grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-9); }
    .contact__info { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-6)); }
  }
  .contact__info :global(.sh) { margin-block-end: var(--space-6); }

  /* ---- WhatsApp card ---- */
  :global(.wa-card) {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    padding: var(--space-6);
  }
  .wa-card__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 50%;
    color: #fff;
    background: radial-gradient(circle at 30% 25%, #3ce07a, #1faa55 70%);
    box-shadow: 0 8px 26px -6px rgb(31 170 85 / 0.6);
  }
  .wa-card__body { display: grid; gap: var(--space-3); justify-items: start; }
  .wa-card__text { color: var(--text-muted); margin-block-end: var(--space-2); }
  @media (max-width: 480px) {
    :global(.wa-card) { flex-direction: column; gap: var(--space-4); padding: var(--space-5); }
    .wa-card__body { justify-items: stretch; }
    .wa-card__body :global(.btn) { white-space: normal; text-align: center; }
  }

  /* ---- Facts ---- */
  .facts { display: grid; gap: 0; margin-block-start: var(--space-6); border-block-start: 1px solid var(--line); }
  .fact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--line);
  }
  .fact__label { color: var(--text-faint); align-self: center; }
  .fact__value { margin: 0; color: var(--text); font-weight: 500; }

  /* ---- Form panel ---- */
  :global(.cf-panel) { padding: clamp(1.5rem, 1rem + 2vw, 2.75rem); overflow: hidden; }
  .cf-panel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-5);
  }
  .cf-panel__req { font-size: 0.8125rem; color: var(--text-faint); }
  .cf-panel__req span { color: var(--accent); }

  .cf { display: grid; gap: var(--space-2); }
  .cf__row { display: grid; gap: var(--space-2) var(--space-4); }
  @media (min-width: 640px) { .cf__row { grid-template-columns: 1fr 1fr; } }
  .cf__hp { display: none !important; }

  .cf__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-block-start: var(--space-3);
  }
  .cf__privacy { font-size: 0.8125rem; color: var(--text-faint); }

  .cf__alert {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--danger) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--danger) 35%, transparent);
    font-size: var(--fs-small);
    animation: cf-pop 420ms var(--ease-out) both;
  }
  .cf__alert p { flex: 1 1 14rem; }
  .cf__alert-icon {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    color: var(--bg-0);
    background: var(--danger);
    box-shadow: 0 0 16px color-mix(in oklab, var(--danger) 50%, transparent);
  }
  .cf__alert-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-weight: 500;
    font-size: 0.8125rem;
  }
  .cf__alert-link:hover { border-color: #25d366; color: #3ce07a; }

  /* ---- Success ---- */
  .cf-success {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding-block: var(--space-8);
    text-align: center;
    animation: cf-pop 600ms var(--ease-out) both;
  }
  .cf-success:focus { outline: none; }
  .cf-success__icon {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 5rem;
    block-size: 5rem;
    margin-block-end: var(--space-3);
    border-radius: 50%;
    color: var(--bg-0);
    background: var(--success);
    box-shadow: 0 0 30px color-mix(in oklab, var(--success) 55%, transparent);
    animation: cf-check 700ms var(--ease-spring) 120ms both;
  }
  .cf-success__icon::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--success) 50%, transparent);
    animation: cf-ring 1600ms var(--ease-out) 300ms both;
  }
  .cf-success :global(.btn) { margin-block-start: var(--space-4); }
  @keyframes cf-pop { from { opacity: 0; transform: translate3d(0, 10px, 0); } }
  @keyframes cf-check { from { opacity: 0; transform: scale(0.4) rotate(-20deg); } }
  @keyframes cf-ring { from { opacity: 1; transform: scale(0.8); } to { opacity: 0; transform: scale(1.5); } }
</style>
