---
/**
 * Hero — the showpiece. Full-height, headline at the inline start, hovering drone at the inline end
 * (mirrors automatically in Hebrew). On mobile the drone comes first.
 * Load sequence: staggered CSS entrance. Scroll: CSS scroll-driven parallax (progressive enhancement, zero JS).
 */
import Button from '../ui/Button.astro';
import HeroVisual from '../ui/HeroVisual.astro';
import { content, shared } from '../../content/site';
import type { Lang } from '../../i18n/utils';
// TODO: replace with the client's hero photo (dark background or transparent PNG works best for 'cutout' mode)
import heroImg from '../../assets/hero/hero-drone.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---
<section class="hero" id="top" data-section aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow t-mono" style="--d: 0">{t.eyebrow}</p>
      <h1 class="hero__title t-display" id="hero-title" style="--d: 1">
        <span class="hero__lead">{t.titleLead}</span>{' '}
        <span class="t-gradient">{t.titleAccent}</span>
      </h1>
      <p class="hero__tag t-lead" style="--d: 2">{t.tagline}</p>
      <div class="hero__cta" style="--d: 3">
        <Button href="#contact" variant="primary" size="lg" icon="arrow">{t.ctaPrimary}</Button>
        <Button href="#builds" variant="ghost" size="lg">{t.ctaSecondary}</Button>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__visual-in">
        <HeroVisual
          image={heroImg}
          alt={t.imageAlt}
          mode={shared.hero.mode}
          readouts={[...shared.hero.readouts]}
          frameLabels={shared.hero.frameLabels}
          priority
        />
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label={t.scroll}>
    <span class="hero__scroll-line" aria-hidden="true"><span class="hero__scroll-dot"></span></span>
    <span class="t-mono" aria-hidden="true">{t.scroll}</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + var(--space-5)) var(--space-10);
    overflow: clip;
  }
  .hero__glow {
    position: absolute;
    inset-block-start: -10%;
    inset-inline-end: -15%;
    inline-size: min(1100px, 120vw);
    aspect-ratio: 1;
    background:
      radial-gradient(closest-side, var(--accent-10), transparent 70%),
      radial-gradient(closest-side at 35% 65%, var(--secondary-20), transparent 75%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .hero__visual {
    order: -1;
    inline-size: min(100%, 34rem);
    margin-inline: auto;
  }
  .hero__copy { display: grid; justify-items: start; }

  .hero__eyebrow { color: var(--accent); margin-block-end: var(--space-5); }
  .hero__title { max-inline-size: 12ch; }
  .hero__tag { margin-block-start: var(--space-5); max-inline-size: 34rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-6); }

  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 1.08fr 1fr; gap: var(--space-8); }
    .hero__visual { order: 0; inline-size: 100%; max-inline-size: 38rem; }
  }
  @media (max-width: 480px) {
    .hero { padding-block-start: calc(var(--header-h) + var(--space-2)); }
    .hero__visual { inline-size: 100%; }
    .hero__eyebrow { letter-spacing: 0.07em; font-size: 0.6875rem; }
    .hero__cta { display: grid; grid-template-columns: 1fr 1fr; inline-size: 100%; }
    .hero__cta :global(.btn) { --btn-pad-inline: 0.9rem; }
  }

  /* ---- Load sequence (staggered entrance) ---- */
  .hero__copy > * {
    animation: hero-in 900ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--d, 0) * 110ms);
  }
  .hero__visual-in { animation: hero-drone-in 1200ms var(--ease-out) 60ms both; }
  .hero__visual-in :global(.rings) { animation: hero-fade 1600ms var(--ease-out) 400ms both; }
  @keyframes hero-in {
    from { opacity: 0; transform: translate3d(0, 24px, 0); }
  }
  @keyframes hero-drone-in {
    from { opacity: 0; transform: translate3d(0, 28px, 0) scale(0.96); }
  }
  @keyframes hero-fade {
    from { opacity: 0; }
  }

  /* ---- Scroll-driven parallax (progressive enhancement) ---- */
  @supports (animation-timeline: scroll()) {
    .hero__visual {
      animation: hero-parallax-visual linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 100svh;
    }
    .hero__copy {
      animation: hero-parallax-copy linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 100svh;
    }
    .hero__scroll {
      animation: hero-fade-out linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 25svh;
    }
  }
  @keyframes hero-parallax-visual {
    to { transform: translate3d(0, 22svh, 0) scale(0.94); opacity: 0.35; }
  }
  @keyframes hero-parallax-copy {
    to { transform: translate3d(0, 10svh, 0); opacity: 0; }
  }
  @keyframes hero-fade-out {
    to { opacity: 0; }
  }

  /* ---- Scroll indicator ---- */
  .hero__scroll {
    position: absolute;
    inset-block-end: var(--space-5);
    inset-inline: 0;
    margin-inline: auto;
    inline-size: max-content;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    color: var(--text-faint);
    border-radius: var(--radius-sm);
    transition: color var(--dur-base) var(--ease-out);
  }
  .hero__scroll:hover { color: var(--accent); }
  .hero__scroll-line {
    position: relative;
    inline-size: 1px;
    block-size: 44px;
    background: linear-gradient(var(--line-strong), transparent);
    overflow: hidden;
  }
  .hero__scroll-dot {
    position: absolute;
    inset-inline-start: -1.5px;
    inline-size: 4px;
    block-size: 10px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: var(--glow-sm);
    animation: scroll-dot 2.2s var(--ease-in-out) infinite;
  }
  @keyframes scroll-dot {
    0% { transform: translateY(-12px); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(46px); opacity: 0; }
  }
  @media (max-height: 640px) and (max-width: 959px) {
    .hero__scroll { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy > *, .hero__visual-in, .hero__visual-in :global(.rings),
    .hero__visual, .hero__copy, .hero__scroll, .hero__scroll-dot { animation: none !important; }
  }
</style>
