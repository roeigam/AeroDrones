---
/**
 * Gallery card. Semantics: <h3> contains a real <button> (opens the lightbox); the button's
 * hit area is stretched over the whole card, so the full card is clickable but there's
 * exactly one interactive element. Image zooms on hover; specs as telemetry chips.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import GlassCard from '../ui/GlassCard.astro';
import SpecChip from '../ui/SpecChip.astro';
import BidiText from '../ui/BidiText.astro';
import Icon from '../ui/Icon.astro';
import { content } from '../../content/site';
import type { Lang } from '../../i18n/utils';

interface Props {
  build: CollectionEntry<'builds'>;
  index: number;
  lang: Lang;
}
const { build, index, lang } = Astro.props;
const t = content[lang].builds;
const { name, image, specs } = build.data;
const MAX_CHIPS = 3;
const shown = specs.slice(0, MAX_CHIPS);
const extra = specs.length - shown.length;
const num = String(index + 1).padStart(2, '0');
---
<GlassCard as="li" class="bc" data-reveal style={`--i: ${index % 3}`}>
  <div class="bc__media">
    <Picture
      src={image}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 640, 900]}
      sizes="(max-width: 767px) 92vw, (max-width: 1099px) 46vw, 25rem"
      loading="lazy"
      decoding="async"
      class="bc__img"
    />
    <span class="bc__shade" aria-hidden="true"></span>
    <span class="bc__idx" dir="ltr" aria-hidden="true">BUILD/{num}</span>
    <span class="bc__expand" aria-hidden="true"><Icon name="expand" size={18} /></span>
  </div>
  <div class="bc__body">
    <h3 class="bc__name t-h3">
      <button class="bc__btn" type="button" data-lb-open={index} aria-haspopup="dialog">
        <span class="visually-hidden">{t.open}: </span><BidiText text={name[lang]} lang={lang} />
      </button>
    </h3>
    <ul class="bc__chips" role="list">
      {shown.map((s) => <li><SpecChip text={s} lang={lang} size="sm" /></li>)}
      {extra > 0 && (
        <li class="bc__more">
          <span aria-hidden="true" dir="ltr">+{extra}</span>
          <span class="visually-hidden">{extra} {t.moreSpecs}</span>
        </li>
      )}
    </ul>
  </div>
</GlassCard>

<style>
  :global(.bc) { display: flex; flex-direction: column; overflow: hidden; }
  .bc__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-start-start-radius: var(--radius-lg);
    border-start-end-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .bc__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .bc__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(4 7 13 / 0.7));
    pointer-events: none;
  }
  .bc__idx {
    position: absolute;
    inset-block-end: var(--space-3);
    inset-inline-start: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--accent-soft);
    text-shadow: 0 0 8px rgb(0 0 0 / 0.9);
  }
  .bc__expand {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 50%;
    color: var(--text);
    background: rgb(4 7 13 / 0.6);
    border: 1px solid var(--line-strong);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-spring);
  }

  .bc__body { display: grid; gap: var(--space-3); padding: var(--space-5); flex: 1; align-content: start; }
  .bc__name { font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem); }
  .bc__btn {
    font: inherit;
    color: inherit;
    text-align: start;
    letter-spacing: inherit;
  }
  /* stretch the button's hit area over the whole card */
  .bc__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--radius-lg);
  }
  .bc__btn:focus-visible { outline: none; }
  .bc__btn:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 3px; }

  .bc__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  .bc__more {
    display: inline-grid;
    place-items: center;
    padding-inline: 0.6em;
    border-radius: var(--radius-sm);
    border: 1px dashed var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  @media (hover: hover) {
    :global(.bc:hover) .bc__media :global(img) { transform: scale(1.07); }
    :global(.bc:hover) .bc__expand { opacity: 1; transform: none; }
  }
  :global(.bc:has(.bc__btn:focus-visible)) .bc__expand { opacity: 1; transform: none; }
</style>
