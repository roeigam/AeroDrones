---
/**
 * Native <dialog> lightbox (no library). Layout: image stage at the inline start, info panel at the
 * inline end (stacked on mobile). Behavior lives in src/scripts/lightbox.ts:
 * next/prev buttons, arrow keys and swipe follow the document direction; Esc closes;
 * showModal() traps focus; focus returns to the card that opened it.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SpecChip from '../ui/SpecChip.astro';
import BidiText from '../ui/BidiText.astro';
import Icon from '../ui/Icon.astro';
import { content } from '../../content/site';
import type { Lang } from '../../i18n/utils';

interface Props {
  builds: CollectionEntry<'builds'>[];
  lang: Lang;
}
const { builds, lang } = Astro.props;
const t = content[lang].builds;
const total = builds.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<dialog class="lb" aria-label={t.dialogLabel} data-lightbox data-of={t.of}>
  <div class="lb__panel" data-lb-panel>
    <div class="lb__stage" data-lb-stage>
      {builds.map((b, i) => (
        <div class="lb__media" data-lb-media={i} hidden>
          <Picture
            src={b.data.image}
            alt={b.data.name[lang]}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 899px) 100vw, 46rem"
            loading="lazy"
            decoding="async"
            class="lb__img"
          />
        </div>
      ))}
      <span class="lb__corner lb__corner--ss" aria-hidden="true"></span>
      <span class="lb__corner lb__corner--se" aria-hidden="true"></span>
      <span class="lb__corner lb__corner--es" aria-hidden="true"></span>
      <span class="lb__corner lb__corner--ee" aria-hidden="true"></span>

      <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label={t.prev}>
        <Icon name="chevron" size={22} />
      </button>
      <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label={t.next}>
        <Icon name="chevron" size={22} />
      </button>
    </div>

    <div class="lb__side">
      <div class="lb__top">
        <p class="lb__count" dir="ltr" aria-hidden="true">
          <span data-lb-current>01</span><span class="lb__count-total"> / {pad(total)}</span>
        </p>
        <span class="lb__progress" aria-hidden="true"><span data-lb-bar></span></span>
        <button class="lb__close" type="button" data-lb-close aria-label={t.close} autofocus>
          <Icon name="close" size={20} />
        </button>
      </div>

      {builds.map((b, i) => (
        <div
          class="lb__info"
          data-lb-info={i}
          role="group"
          aria-roledescription={t.slide}
          aria-label={`${i + 1} ${t.of} ${total}`}
          hidden
        >
          <p class="lb__idx" dir="ltr">BUILD/{pad(i + 1)}</p>
          <h2 class="lb__name"><BidiText text={b.data.name[lang]} lang={lang} /></h2>
          {b.data.description && (
            <p class="lb__desc"><BidiText text={b.data.description[lang]} lang={lang} /></p>
          )}
          <p class="lb__specs-title t-mono">{t.specsTitle}</p>
          <ul class="lb__specs" role="list">
            {b.data.specs.map((s) => <li><SpecChip text={s} lang={lang} /></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-lb-live></p>
</dialog>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  /* ---- Dialog shell: full viewport, transparent; the panel is the visible surface ---- */
  .lb {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: 100%;
    max-block-size: 100%;
    margin: 0;
    padding: clamp(0rem, 3vw, 2rem);
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: hidden;
  }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop {
    background:
      radial-gradient(60% 50% at 50% 40%, color-mix(in oklab, var(--accent) 8%, transparent), transparent 70%),
      rgb(2 4 10 / 0.78);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    backdrop-filter: blur(12px) saturate(120%);
  }

  .lb__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(19rem, 1fr);
    inline-size: min(76rem, 100%);
    block-size: min(44rem, 100%);
    grid-template-rows: minmax(0, 1fr);
    border-radius: var(--radius-lg);
    background: var(--glass-bg-strong);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg), 0 0 80px -20px var(--accent-35);
    overflow: hidden;
  }

  /* ---- Stage ---- */
  .lb__stage {
    position: relative;
    display: grid;
    background: radial-gradient(70% 60% at 50% 50%, color-mix(in oklab, var(--accent) 6%, #02050b), #02050b);
    min-block-size: 0;
    touch-action: pan-y;
  }
  .lb__media { grid-area: 1 / 1; display: grid; place-items: center; min-block-size: 0; overflow: hidden; }
  .lb__media :global(img) { inline-size: 100%; block-size: 100%; object-fit: contain; }
  .lb__media.is-entering { animation: lb-media-in 520ms var(--ease-out) both; }
  .lb__media.is-leaving { animation: lb-media-out 320ms var(--ease-out) both; }
  @keyframes lb-media-in {
    from { opacity: 0; transform: translate3d(calc(var(--lb-dir, 1) * 48px), 0, 0) scale(0.985); }
  }
  @keyframes lb-media-out {
    to { opacity: 0; transform: translate3d(calc(var(--lb-dir, 1) * -32px), 0, 0); }
  }

  .lb__corner {
    position: absolute;
    inline-size: 22px;
    block-size: 22px;
    border: 0 solid var(--accent-60);
    pointer-events: none;
  }
  .lb__corner--ss { inset-block-start: 14px; inset-inline-start: 14px; border-block-start-width: 1.5px; border-inline-start-width: 1.5px; }
  .lb__corner--se { inset-block-start: 14px; inset-inline-end: 14px; border-block-start-width: 1.5px; border-inline-end-width: 1.5px; }
  .lb__corner--es { inset-block-end: 14px; inset-inline-start: 14px; border-block-end-width: 1.5px; border-inline-start-width: 1.5px; }
  .lb__corner--ee { inset-block-end: 14px; inset-inline-end: 14px; border-block-end-width: 1.5px; border-inline-end-width: 1.5px; }

  .lb__nav {
    position: absolute;
    inset-block-start: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    margin-block-start: -1.5rem;
    border-radius: 50%;
    color: var(--text);
    background: rgb(4 7 13 / 0.6);
    border: 1px solid var(--line-strong);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: transform var(--dur-base) var(--ease-spring), border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .lb__nav--prev { inset-inline-start: var(--space-4); }
  .lb__nav--next { inset-inline-end: var(--space-4); }
  /* chevron points to inline-end by default (mirrors in RTL); "prev" points the other way */
  .lb__nav--prev :global(svg) { transform: scaleX(-1); }
  :global([dir='rtl']) .lb__nav--prev :global(svg) { transform: none; }
  @media (hover: hover) {
    .lb__nav:hover { color: var(--accent); border-color: var(--accent-60); transform: scale(1.08); }
  }
  .lb__nav:active { transform: scale(0.94); }

  /* ---- Side panel ---- */
  .lb__side {
    display: flex;
    flex-direction: column;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-inline-start: 1px solid var(--line);
  }
  .lb__top {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: color-mix(in oklab, var(--surface-1) 92%, transparent);
    border-block-end: 1px solid var(--line);
  }
  .lb__count {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-lg);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .lb__count-total { color: var(--text-faint); }
  .lb__progress {
    flex: 1;
    block-size: 2px;
    border-radius: 2px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .lb__progress span {
    display: block;
    block-size: 100%;
    background: var(--grad-accent);
    box-shadow: 0 0 8px var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: var(--origin-inline-start);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .lb__close {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text);
    transition: transform var(--dur-base) var(--ease-spring), color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .lb__close:hover { color: var(--accent); border-color: var(--accent-60); transform: rotate(90deg); }
  }

  .lb__info {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6) var(--space-5) var(--space-7);
  }
  .lb__info.is-entering { animation: lb-info-in 520ms var(--ease-out) both; }
  @keyframes lb-info-in { from { opacity: 0; transform: translate3d(0, 12px, 0); } }
  .lb__idx { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em; color: var(--accent-soft); }
  .lb__name {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .lb__desc { color: var(--text-muted); }
  .lb__specs-title { margin-block-start: var(--space-4); color: var(--text-faint); }
  .lb__specs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }

  /* ---- Open / close animation (transform + opacity only) ---- */
  .lb[open] .lb__panel { animation: lb-in 480ms var(--ease-out) both; }
  .lb[open]::backdrop { animation: lb-fade-in 380ms var(--ease-out) both; }
  .lb.is-closing .lb__panel { animation: lb-out 260ms var(--ease-in-out) both; }
  .lb.is-closing::backdrop { animation: lb-fade-out 260ms var(--ease-in-out) both; }
  @keyframes lb-in { from { opacity: 0; transform: translate3d(0, 16px, 0) scale(0.97); } }
  @keyframes lb-out { to { opacity: 0; transform: translate3d(0, 10px, 0) scale(0.98); } }
  @keyframes lb-fade-in { from { opacity: 0; } }
  @keyframes lb-fade-out { to { opacity: 0; } }

  /* ---- Mobile / tablet: stacked, full-screen ---- */
  @media (max-width: 899px) {
    .lb { padding: 0; }
    .lb__panel {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      inline-size: 100%;
      block-size: 100%;
      border-radius: 0;
      border: 0;
    }
    .lb__stage { aspect-ratio: 4 / 3; max-block-size: 56svh; inline-size: 100%; }
    .lb__side { border-inline-start: 0; }
    .lb__nav { inline-size: 2.6rem; block-size: 2.6rem; margin-block-start: -1.3rem; }
    .lb__nav--prev { inset-inline-start: var(--space-3); }
    .lb__nav--next { inset-inline-end: var(--space-3); }
    .lb__info { padding: var(--space-5) var(--gutter) var(--space-8); }
  }
</style>
