---
/**
 * Pill language switch "עב / EN" with a sliding indicator.
 * A real link to the other locale; JS (Phase 2) appends the current section hash and stores the choice.
 */
import { langRoot, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  label: string; // accessible label, e.g. "Switch to English"
}
const { lang, label } = Astro.props;
const other: Lang = lang === 'he' ? 'en' : 'he';
---
<a
  class="lt"
  href={langRoot(other)}
  hreflang={other}
  lang={other}
  aria-label={label}
  data-lang-toggle
  data-target-lang={other}
>
  <span class="lt__track" dir="ltr" aria-hidden="true">
    <span class:list={['lt__thumb', lang === 'en' && 'lt__thumb--end']}></span>
    <span class:list={['lt__opt', lang === 'he' && 'is-active']} lang="he">עב</span>
    <span class:list={['lt__opt', lang === 'en' && 'is-active']}>EN</span>
  </span>
</a>

<style>
  .lt {
    display: inline-flex;
    border-radius: var(--radius-pill);
    -webkit-tap-highlight-color: transparent;
  }
  .lt__track {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: color-mix(in oklab, var(--surface-1) 75%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .lt__opt {
    position: relative;
    z-index: 1;
    min-inline-size: 2.4rem;
    padding: 0.35rem 0.6rem;
    text-align: center;
    color: var(--text-muted);
    transition: color var(--dur-base) var(--ease-out);
  }
  .lt__opt[lang='he'] { font-family: var(--font-body); letter-spacing: 0; }
  .lt__opt.is-active { color: var(--on-accent); }
  .lt__thumb {
    position: absolute;
    inset-block: 3px;
    inset-inline-start: 3px;
    inline-size: calc(50% - 3px);
    border-radius: var(--radius-pill);
    background: var(--accent);
    box-shadow: var(--glow-sm);
    transition: transform var(--dur-slow) var(--ease-spring);
  }
  .lt__thumb--end { transform: translateX(100%); }
  @media (hover: hover) {
    .lt:hover .lt__opt:not(.is-active) { color: var(--text); }
    .lt:hover .lt__thumb:not(.lt__thumb--end) { transform: translateX(8%); }
    .lt:hover .lt__thumb--end { transform: translateX(92%); }
  }
</style>
