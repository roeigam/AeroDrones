---
/**
 * PHASE 1 STYLE TILE — temporary review page (noindex). Removed in Phase 6.
 * Sample copy here is demo-only (not site content); real copy lives in src/content/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/ui/Brand.astro';
import Button from '../components/ui/Button.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import SpecChip from '../components/ui/SpecChip.astro';
import HudFrame from '../components/ui/HudFrame.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import HeroVisual from '../components/ui/HeroVisual.astro';
import Icon from '../components/ui/Icon.astro';
import Field from '../components/ui/Field.astro';
import LangToggle from '../components/LangToggle.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { Picture } from 'astro:assets';
import heroImg from '../assets/hero/hero-drone.jpg';
import aboutImg from '../assets/about/about-builder.jpg';
import carbonImg from '../assets/decor/carbon-closeup.jpg';
import redQuadImg from '../assets/decor/red-quad.jpg';

const swatches = [
  { token: '--bg-0', hex: '#04070D', note: 'page base' },
  { token: '--bg-1', hex: '#070C17', note: 'section band' },
  { token: '--surface-1', hex: '#0B1322', note: 'surface' },
  { token: '--surface-2', hex: '#101A2E', note: 'surface' },
  { token: '--surface-3', hex: '#16233D', note: 'surface' },
  { token: '--accent', hex: '#2DE2FF', note: 'accent (swap point)' },
  { token: '--secondary', hex: '#7B6CFF', note: 'gradient partner' },
  { token: '--text', hex: '#EAF1FA', note: 'text' },
  { token: '--text-muted', hex: '#93A3BC', note: 'secondary text' },
  { token: '--text-faint', hex: '#5D6E89', note: 'decorative only' },
  { token: '--success', hex: '#3EE6A8', note: 'success' },
  { token: '--danger', hex: '#FF6B7A', note: 'error' },
];
const accents = [
  { name: 'Cyan', value: '#2de2ff', on: '#021018' },
  { name: 'Lime', value: '#b6ff3b', on: '#0b1402' },
  { name: 'Amber', value: '#ffb547', on: '#1a0e00' },
  { name: 'Signal', value: '#ff6a3d', on: '#1a0600' },
  { name: 'Magenta', value: '#ff4fd8', on: '#1a0215' },
];
const readouts = [
  { k: 'ALT', v: '120.4', u: 'm' },
  { k: 'SPD', v: '0.0', u: 'm/s' },
  { k: 'BAT', v: '16.8', u: 'V' },
  { k: 'GPS', v: '14', u: 'SAT' },
];
const services = [
  { icon: 'build' as const, he: 'בנייה לפי הזמנה', en: 'Custom builds', heText: 'רחפן שתוכנן סביב סגנון הטיסה שלך — מבחירת חלקים ועד טיסת מבחן.', enText: 'A drone designed around how you fly — from parts selection to the maiden flight.' },
  { icon: 'repair' as const, he: 'תיקונים', en: 'Repairs', heText: 'אבחון מהיר, החלפת חלקים והלחמות — חזרה לאוויר בלי לנחש.', enText: 'Fast diagnosis, part swaps and soldering — back in the air without guesswork.' },
  { icon: 'tune' as const, he: 'שדרוגים וכיוונון', en: 'Upgrades & tuning', heText: 'PID, פילטרים, VTX וסוללות — טיסה חלקה ותגובה חדה יותר.', enText: 'PIDs, filters, VTX and power — smoother flight and a sharper response.' },
];
const specsHe = ['מנועים 2207 1950KV', 'סוללה 6S 1300mAh', 'בקר F405', 'משקל 648g', 'מצלמה 4K', 'ESC 45A'];
const specsEn = ['2207 1950KV motors', '6S 1300mAh', 'F405 FC', '648g AUW', '4K camera', '45A ESC'];
---
<BaseLayout lang="he" title="Style tile — AeroDrones" description="Phase 1 style tile" noindex>
  <header class="tb">
    <div class="tb__in container">
      <Brand lang="he" size="sm" />
      <span class="tb__tag t-mono">STYLE TILE · v1</span>
      <div class="tb__ctrl">
        <div class="tb__group" role="group" aria-label="Direction">
          <button class="tb__btn is-on" data-dir="rtl" type="button" lang="he">עברית · RTL</button>
          <button class="tb__btn" data-dir="ltr" type="button">EN · LTR</button>
        </div>
        <div class="tb__group" role="group" aria-label="Accent">
          {accents.map((a, i) => (
            <button
              class:list={['tb__swatch', i === 0 && 'is-on']}
              type="button"
              data-accent={a.value}
              data-on={a.on}
              style={`--sw: ${a.value}`}
              aria-label={`Accent ${a.name}`}
              title={a.name}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- ================= HERO PREVIEW ================= -->
    <section class="section hero-prev">
      <div class="container hero-prev__grid">
        <div class="hero-prev__copy">
          <p class="hero-prev__eyebrow t-mono" dir="ltr">// CUSTOM FPV · BUILD · REPAIR · TUNE</p>
          <h1 class="t-display" lang="he">רחפנים שנבנים <span class="t-gradient">לעוף.</span></h1>
          <p class="t-display hero-prev__en" lang="en" dir="ltr">Drones built <span class="t-gradient">to fly.</span></p>
          <p class="t-lead hero-prev__tag">
            בנייה בעבודת יד, תיקונים ושדרוגים לרחפני FPV — מכל חלק ועד טיסת המבחן.
          </p>
          <div class="hero-prev__cta">
            <Button variant="primary" size="lg" icon="arrow" href="#form">צרו קשר</Button>
            <Button variant="ghost" size="lg" href="#cards">לבנייה שלי</Button>
          </div>
        </div>
        <div class="hero-prev__visual">
          <div class="mode-switch tb__group" role="group" aria-label="Hero mode">
            <button class="tb__btn is-on" type="button" data-mode="cutout">cutout</button>
            <button class="tb__btn" type="button" data-mode="framed">framed</button>
          </div>
          <div data-mode-panel="cutout">
            <HeroVisual image={heroImg} alt="רחפן FPV עם מצלמת אקשן" mode="cutout" readouts={readouts} priority />
          </div>
          <div data-mode-panel="framed" hidden>
            <HeroVisual
              image={heroImg}
              alt="רחפן FPV עם מצלמת אקשן"
              mode="framed"
              readouts={readouts}
              frameLabels={{ end: 'CAM-01', bottomStart: '32.08°N 34.78°E', bottomEnd: '1080p · 120fps' }}
            />
          </div>
        </div>
      </div>
      <a class="scroll-ind" href="#palette" aria-label="Scroll">
        <span class="scroll-ind__line"><span class="scroll-ind__dot"></span></span>
        <span class="t-mono" dir="ltr">SCROLL</span>
      </a>
    </section>

    <!-- ================= PALETTE ================= -->
    <section class="section section--band" id="palette">
      <div class="container">
        <SectionHeading num="01" label="PALETTE · צבעים" title="Deep navy, one electric accent." lede="Layered surfaces create depth. Accent tints, glows and borders all derive from --accent, so one variable re-themes everything (try the swatches in the bar above)." />
        <ul class="swatches" role="list">
          {swatches.map((s, i) => (
            <li class="sw" data-reveal style={`--i: ${i % 6}`}>
              <span class="sw__chip" style={`background: var(${s.token})`}></span>
              <span class="sw__meta" dir="ltr">
                <span class="t-mono sw__tok">{s.token}</span>
                <span class="sw__hex">{s.hex}</span>
                <span class="sw__note">{s.note}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="grads">
          <div class="grad" style="background: var(--grad-accent)"><span class="t-mono">--grad-accent</span></div>
          <div class="grad grad--text"><span class="t-gradient t-h2">Gradient text</span><span class="t-mono">--grad-text</span></div>
          <div class="grad grad--glow"><span class="t-mono">--glow-lg</span></div>
        </div>
      </div>
    </section>

    <!-- ================= TYPOGRAPHY ================= -->
    <section class="section">
      <div class="container">
        <SectionHeading num="02" label="TYPE · טיפוגרפיה" title="Rubik · Heebo · JetBrains Mono" />
        <div class="type-grid">
          <div class="type-col" lang="he" dir="rtl">
            <p class="t-mono type-cap">Rubik 800 — Display</p>
            <p class="t-display">טיסה מדויקת.</p>
            <p class="t-mono type-cap">Rubik 700 — H2</p>
            <p class="t-h2">כל בנייה מתחילה בשרטוט</p>
            <p class="t-mono type-cap">Rubik 700 — H3</p>
            <p class="t-h3">כיוונון PID ופילטרים</p>
            <p class="t-mono type-cap">Heebo 400 — Lead / Body</p>
            <p class="t-lead">מבחר חלקים קפדני, הלחמות נקיות וכיוונון עד שהרחפן מרגיש כמו המשך של היד.</p>
            <p>אני בונה, מתקן ומשדרג רחפני FPV כבר שנים. כל רחפן עובר בדיקות על שולחן העבודה ובשטח לפני שהוא יוצא אליך — כולל <bdi>Blackbox</bdi> ובדיקת רעידות.</p>
          </div>
          <div class="type-col" lang="en" dir="ltr">
            <p class="t-mono type-cap">Rubik 800 — Display</p>
            <p class="t-display">Precision flight.</p>
            <p class="t-mono type-cap">Rubik 700 — H2</p>
            <p class="t-h2">Every build starts on the blueprint</p>
            <p class="t-mono type-cap">Rubik 700 — H3</p>
            <p class="t-h3">PID &amp; filter tuning</p>
            <p class="t-mono type-cap">Heebo 400 — Lead / Body</p>
            <p class="t-lead">Careful parts selection, clean soldering and tuning until the drone feels like an extension of your hand.</p>
            <p>I've been building, repairing and upgrading FPV drones for years. Every quad is bench-tested and field-tested before it reaches you — including Blackbox logs and a vibration check.</p>
          </div>
        </div>
        <div class="mono-row">
          <span class="t-mono">JetBrains Mono · 01 / ABOUT</span>
          <span class="t-mono" style="color: var(--accent)">ALT 120.4 m · SPD 0.0 m/s</span>
          <span class="t-mono" style="color: var(--text-faint)">32.08°N 34.78°E</span>
        </div>
      </div>
    </section>

    <!-- ================= BUTTONS ================= -->
    <section class="section section--band">
      <div class="container">
        <SectionHeading num="03" label="BUTTONS · כפתורים" title="Glow, sheen, lift." lede="Hover: lift + glow + sheen sweep. Press: slight squash. Arrows mirror in RTL. Focus: accent ring (use Tab)." />
        <div class="btn-row">
          <Button variant="primary" size="lg" icon="arrow">צרו קשר</Button>
          <Button variant="ghost" size="lg">לבנייה שלי</Button>
          <Button variant="primary" iconStart="send">שליחה</Button>
          <Button variant="primary" data-loading aria-busy="true">שליחה</Button>
          <Button variant="primary" disabled>Disabled</Button>
          <Button variant="ghost" icon="arrow">Ghost + arrow</Button>
        </div>
        <div class="btn-row">
          <a class="link" href="#cards">קישור טקסט עם קו מונפש</a>
          <a class="link" href="#cards" lang="en">Animated text link</a>
          <LangToggle lang="he" label="Switch to English" />
          <LangToggle lang="en" label="החלפה לעברית" />
          <nav class="social" aria-label="Social">
            <a class="social__a" href="#" aria-label="Instagram"><Icon name="instagram" /></a>
            <a class="social__a" href="#" aria-label="YouTube"><Icon name="youtube" /></a>
            <a class="social__a" href="#" aria-label="TikTok"><Icon name="tiktok" /></a>
            <a class="social__a" href="#" aria-label="Facebook"><Icon name="facebook" /></a>
          </nav>
          <WhatsAppFab href="#" label="WhatsApp" floating={false} />
        </div>
      </div>
    </section>

    <!-- ================= CARDS ================= -->
    <section class="section" id="cards">
      <div class="container">
        <SectionHeading num="04" label="CARDS · כרטיסים" title="Glass cards & build cards" lede="Translucent blurred surface, thin gradient border. Hover: lift, glow, border lights up." />
        <ul class="cards" role="list">
          {services.map((s, i) => (
            <GlassCard as="li" class="svc" data-reveal style={`--i: ${i}`}>
              <span class="svc__icon"><Icon name={s.icon} size={30} strokeWidth={1.4} /></span>
              <h3 class="t-h3">{s.he}</h3>
              <p class="t-muted">{s.heText}</p>
              <span class="svc__num t-mono" dir="ltr">0{i + 1}</span>
            </GlassCard>
          ))}
        </ul>

        <ul class="cards cards--builds" role="list">
          {[{ img: redQuadImg, name: 'Falcon 5"', alt: 'רחפן FPV אדום על רקע כהה' }, { img: carbonImg, name: 'Carbon Ghost 7"', alt: 'תקריב של שלדת קרבון ומדחף' }, { img: heroImg, name: 'Neon Freestyle', alt: 'רחפן FPV עם מצלמה' }].map((b, i) => (
            <GlassCard as="li" class="bc" data-reveal style={`--i: ${i}`}>
              <button class="bc__btn" type="button" aria-label={`פתיחת ${b.name}`}>
                <span class="bc__media">
                  <Picture src={b.img} alt={b.alt} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" loading="lazy" class="bc__img" />
                  <span class="bc__expand"><Icon name="expand" size={18} /></span>
                  <span class="bc__idx t-mono" dir="ltr">BUILD/0{i + 1}</span>
                </span>
                <span class="bc__body">
                  <span class="bc__name t-h3"><bdi>{b.name}</bdi></span>
                  <span class="bc__chips">
                    {specsHe.slice(i, i + 3).map((s) => <SpecChip text={s} lang="he" size="sm" />)}
                  </span>
                </span>
              </button>
            </GlassCard>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= CHIPS + HUD ================= -->
    <section class="section section--band">
      <div class="container split">
        <div>
          <SectionHeading num="05" label="SPECS · מפרט" title="Telemetry readouts" lede="Mono for Latin & numbers only. In Hebrew, Latin runs are wrapped in <bdi> automatically." />
          <p class="t-mono chip-cap">עברית (RTL + bdi)</p>
          <div class="chips" lang="he" dir="rtl">{specsHe.map((s) => <SpecChip text={s} lang="he" />)}</div>
          <p class="t-mono chip-cap">English (LTR)</p>
          <div class="chips" lang="en" dir="ltr">{specsEn.map((s) => <SpecChip text={s} lang="en" />)}</div>
        </div>
        <div class="hud-demo">
          <div class="glow-pool" style="inline-size: 120%; inset-block-start: -10%; inset-inline-start: -10%;" aria-hidden="true"></div>
          <HudFrame labels={{ end: 'CAM-02', bottomStart: 'ISO 400 · f/2.8', bottomEnd: '32.08°N 34.78°E' }} rec ratio="4 / 5">
            <Picture src={aboutImg} alt="רחפן FPV עם ציור אור" formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(max-width: 900px) 90vw, 40vw" loading="lazy" />
          </HudFrame>
        </div>
      </div>
    </section>

    <!-- ================= FORM ================= -->
    <section class="section" id="form">
      <div class="container container--narrow">
        <SectionHeading num="06" label="FORM · טופס" title="Glowing focus states" lede="Labels follow the page direction; phone and email values are always LTR. Click into a field to see the focus glow." align="center" />
        <GlassCard class="form-panel" interactive={false}>
          <div class="glow-pool form-panel__glow" aria-hidden="true"></div>
          <form class="form" novalidate onsubmit="return false">
            <div class="form__row">
              <Field label="שם מלא" name="name" autocomplete="name" required placeholder="ישראל ישראלי" />
              <Field label="טלפון" name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="050-000-0000" />
            </div>
            <Field label="אימייל" name="email" type="email" autocomplete="email" required value="not-an-email" forceInvalid error="נא להזין כתובת אימייל תקינה" />
            <Field label="הודעה" name="message" type="textarea" required placeholder="ספרו לי על הרחפן שאתם חולמים עליו…" rows={4} />
            <div class="form__foot">
              <Button variant="primary" size="lg" type="submit" icon="send">שליחת הודעה</Button>
            </div>
          </form>
          <div class="status status--ok" role="status">
            <span class="status__icon"><Icon name="check" size={20} strokeWidth={2} /></span>
            <span><strong>ההודעה נשלחה!</strong> אחזור אליך בהקדם.</span>
          </div>
          <div class="status status--err" role="alert">
            <span class="status__icon"><Icon name="alert" size={20} strokeWidth={2} /></span>
            <span><strong>משהו השתבש.</strong> נסו שוב או כתבו לי בוואטסאפ.</span>
          </div>
        </GlassCard>
      </div>
    </section>

    <!-- ================= EFFECTS ================= -->
    <section class="section section--band">
      <div class="container">
        <SectionHeading num="07" label="ATMOSPHERE · אווירה" title="Grid, glow, noise." lede="Animated blueprint grid (drifts one cell per minute, transform-only), radial light pools (gradients, no blur filters), and a static 4.5% noise layer. All motion is disabled under prefers-reduced-motion." />
        <div class="fx">
          <div class="fx__tile fx__tile--grid"><span class="t-mono">blueprint grid</span></div>
          <div class="fx__tile fx__tile--glow"><span class="t-mono">light pools</span></div>
          <div class="fx__tile fx__tile--noise"><span class="t-mono">noise texture</span></div>
        </div>
      </div>
    </section>

    <footer class="tile-foot container">
      <Brand lang="he" size="lg" />
      <p class="t-mono" dir="ltr">© {new Date().getFullYear()} AeroDrones · Phase 1 style tile — not part of the site</p>
    </footer>
  </main>

  <script>
    // Style-tile-only controls: direction preview, accent swap, hero mode switch.
    const root = document.documentElement;
    document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.dir!;
        root.dir = dir;
        root.lang = dir === 'rtl' ? 'he' : 'en';
        document.querySelectorAll('[data-dir]').forEach((b) => b.classList.toggle('is-on', b === btn));
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-accent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.style.setProperty('--accent', btn.dataset.accent!);
        root.style.setProperty('--on-accent', btn.dataset.on!);
        document.querySelectorAll('[data-accent]').forEach((b) => b.classList.toggle('is-on', b === btn));
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode;
        document.querySelectorAll<HTMLElement>('[data-mode-panel]').forEach((p) => (p.hidden = p.dataset.modePanel !== mode));
        document.querySelectorAll('[data-mode]').forEach((b) => b.classList.toggle('is-on', b === btn));
      });
    });
    // Scroll reveal (the production version lives in src/scripts/reveal.ts from Phase 3)
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }),
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>
</BaseLayout>

<style>
  /* ---------- toolbar (tile only) ---------- */
  .tb {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    border-block-end: 1px solid var(--line);
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }
  .tb__in { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); padding-block: var(--space-3); }
  .tb__tag { color: var(--accent); }
  .tb__ctrl { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-inline-start: auto; }
  .tb__group { display: inline-flex; align-items: center; gap: 4px; padding: 3px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); background: var(--surface-1); }
  .tb__btn { padding: 0.3rem 0.75rem; border-radius: var(--radius-pill); font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); }
  .tb__btn[lang='he'] { font-family: var(--font-body); }
  .tb__btn.is-on { background: var(--accent); color: var(--on-accent); }
  .tb__swatch { inline-size: 1.4rem; block-size: 1.4rem; border-radius: 50%; background: var(--sw); box-shadow: inset 0 0 0 2px var(--surface-1); }
  .tb__swatch.is-on { outline: 2px solid var(--text); outline-offset: 1px; }

  /* ---------- hero preview ---------- */
  .hero-prev { min-block-size: calc(100svh - 3.5rem); display: grid; align-content: center; padding-block: var(--space-8) var(--space-10); overflow: clip; }
  .hero-prev__grid { display: grid; gap: var(--space-7); align-items: center; }
  .hero-prev__visual { position: relative; order: -1; max-inline-size: 36rem; margin-inline: auto; inline-size: 100%; }
  .hero-prev__eyebrow { color: var(--accent); margin-block-end: var(--space-5); }
  .hero-prev__en { margin-block-start: var(--space-3); font-size: clamp(1.75rem, 1rem + 3vw, 3rem); color: var(--text-muted); }
  .hero-prev__tag { margin-block-start: var(--space-5); max-inline-size: 34rem; }
  .hero-prev__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-6); }
  .mode-switch { position: absolute; inset-block-start: -0.5rem; inset-inline-end: 0; z-index: 3; }
  @media (min-width: 900px) {
    .hero-prev__grid { grid-template-columns: 1.05fr 1fr; }
    .hero-prev__visual { order: 0; }
  }

  .scroll-ind {
    position: absolute;
    inset-block-end: var(--space-5);
    inset-inline-start: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    color: var(--text-faint);
  }
  :global([dir='rtl']) .scroll-ind { translate: 50% 0; }
