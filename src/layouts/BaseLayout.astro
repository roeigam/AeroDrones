---
/**
 * Base document: <html lang dir>, head meta, robots switch, hreflang alternates, hero-font preload,
 * design tokens, and the fixed background atmosphere (blueprint grid, glow, noise).
 * Open Graph + Twitter tags per language (1200×630 images in public/og/), so links shared on
 * WhatsApp/Telegram/Facebook show a proper preview card.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { content, shared } from '../content/site';
import { DIR, LANGS, langRoot, type Lang } from '../i18n/utils';
// Preload only the display weight used by the hero headline, in the page's own script.
import rubik800He from '@fontsource/rubik/files/rubik-hebrew-800-normal.woff2?url';
import rubik800La from '@fontsource/rubik/files/rubik-latin-800-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  /** true for the real localized pages (adds canonical + hreflang alternates) */
  localized?: boolean;
  skipLabel?: string;
}
const { lang, title, description, noindex = shared.seo.noindex, localized = false, skipLabel } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const preloadFont = lang === 'he' ? rubik800He : rubik800La;
const meta = content[lang].meta;
const pageUrl = new URL(langRoot(lang), site).href;
const ogImage = new URL(`/og/og-${lang}.jpg`, site).href;
const otherLang = LANGS.find((l) => l !== lang)!;
---
<!doctype html>
<html lang={lang} dir={DIR[lang]} data-section="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#04070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={preloadFont} as="font" type="font/woff2" crossorigin />
    {localized && (
      <>
        <link rel="canonical" href={pageUrl} />
        {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(langRoot(l), site).href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(langRoot('he'), site).href} />
      </>
    )}
    {localized && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={shared.brand} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:locale" content={meta.ogLocale} />
        <meta property="og:locale:alternate" content={content[otherLang].meta.ogLocale} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={meta.ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={meta.ogImageAlt} />
      </>
    )}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    {skipLabel && <a class="skip-link" href="#main">{skipLabel}</a>}
    <div class="bg-layers" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="bg-glow"></div>
    </div>
    <div class="bg-noise" aria-hidden="true"></div>
    <slot />
  </body>
</html>
