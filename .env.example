# Copy to .env for local development (never commit .env). On Netlify / Cloudflare Pages, set these
# in the site's environment-variable settings instead.

# Web3Forms access key — free at https://web3forms.com (enter the email that should receive messages).
# It is public by design (it ends up in the page HTML); Web3Forms only ever sends to that one email.
PUBLIC_WEB3FORMS_KEY=

# Production origin, no trailing slash. Used for canonical URLs and absolute og:image URLs
# (WhatsApp link previews need an absolute image URL). Example: https://aerodrones.co.il
SITE_URL=
